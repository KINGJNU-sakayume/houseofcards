{
  "id": "calibration-tunables",
  "step": "CAL",
  "note": "CAL이 조정할 수 있는 계수와 범위의 전체 목록. 이 파일 밖의 계수(효용 가중치, 동학, 타깃, 허용오차)는 바꾸지 않는다. 범위는 탐색 전에 정했다.",
  "objective": {
    "metric": "초기 상태(창당 전) 권역·전국 현재 지지에서 '없음·미정'을 뺀 정당 점유율과 20개 고정 타깃의 오차 제곱합",
    "trainingSeeds": [42, 1, 2, 3, 4],
    "heldOutSeeds": "5..24",
    "heldOutReality": "docs/data/districts-light-2024.json의 2024 권역별 비례 득표(보고만, 탐색에 쓰지 않음)"
  },
  "search": { "kind": "coordinate-descent", "multiplicativeSteps": [2, 1.5, 1.25, 1.1], "maxSweepsPerStep": 6, "order": "sorted parameter path" },
  "parameters": [
    { "path": "seeds.regionalAttachmentWeights.<region>.<party>", "count": 40, "min": 1, "max": 10000, "start": 100 },
    { "path": "politicalModel.parties.<party>.awareness", "count": 5, "min": 50000, "max": 980000 },
    { "path": "politicalModel.parties.<party>.viability", "count": 5, "min": 50000, "max": 950000 }
  ]
